# Copiar a .env en el VPS y llenar con los valores reales.
# NUNCA commitear el .env real — este archivo es solo la plantilla.

# Cadena de conexión de Neon (Settings → Connection string, con pooler).
DATABASE_URL=""

# Dominio público real, sin barra final. Los enlaces que van por WhatsApp
# (.ics, cancelación, acceso al panel) se arman con esto — si queda mal,
# le llegan rotos a la gente.
# Piloto: subdominio de Ámbar Rojo, mismo patrón que checador/reseñas — cero
# costo, cero DNS nuevo que configurar. Cambiar por un dominio propio cuando
# el producto deje de ser piloto y se venda como marca independiente.
NEXT_PUBLIC_BASE_URL="https://citaenclick.ambarrojostudios.cloud"

# Webhook de n8n que arma la plantilla y habla con WhatsApp Cloud API.
# Vacío = el cron no reclama notificaciones y /entrar no manda WhatsApp real
# (cae al modo piloto si SHOW_LOGIN_LINK=true).
N8N_WEBHOOK_URL=""

# Token largo y aleatorio. Protege /api/cron/notifications y
# /api/notifications/:id/failed. El Schedule Trigger de n8n lo manda como
# "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=""

# Basic Auth de /superadmin (alta de negocios). Cambiar los defaults de desarrollo.
SUPERADMIN_USER=""
SUPERADMIN_PASS=""

# "true" muestra el enlace de acceso en pantalla al pedirlo, en vez de
# depender solo de WhatsApp. Pensado para el piloto mientras N8N_WEBHOOK_URL
# no esté armado. Poner en "false" (o quitar la variable) en cuanto n8n esté
# enviando de verdad — con una base de usuarios más grande, mostrar el link
# en pantalla deja de ser un riesgo aceptable.
SHOW_LOGIN_LINK="false"
